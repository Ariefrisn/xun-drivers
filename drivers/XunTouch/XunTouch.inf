;
; XunTouch.inf - FocalTech FT8203 SPI touchscreen for Redmi Pad SE (xun, SM6225)
; Root-enumerated KMDF source driver, exposes a HID touch screen through VHF.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = XunTouch.cat
DriverVer   = ; set by stampinf
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
XunTouch.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceDesc% = XunTouch_Device, Root\XunTouch
%DeviceDesc% = XunTouch_Device, ACPI\XUNT0001
%DeviceDesc% = XunTouch_Device, ACPI\FTS8203

[XunTouch_Device.NT]
CopyFiles = XunTouch_CopyFiles

[XunTouch_CopyFiles]
XunTouch.sys

[XunTouch_Device.NT.HW]
AddReg = XunTouch_HwAddReg

[XunTouch_HwAddReg]
HKR,,"LowerFilters",0x00010000,"vhf"

[XunTouch_Device.NT.Services]
AddService = XunTouch, 0x00000002, XunTouch_Service

[XunTouch_Service]
DisplayName   = %ServiceName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\XunTouch.sys

[XunTouch_Device.NT.Wdf]
KmdfService = XunTouch, XunTouch_WdfSection

[XunTouch_WdfSection]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName     = "xun-woa"
ManufacturerName = "xun-woa"
DiskName         = "XunTouch Installation Disk"
DeviceDesc       = "FocalTech Touch Screen (Redmi Pad SE)"
ServiceName      = "XunTouch"
