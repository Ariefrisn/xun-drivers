;
; XunRpm.inf - RPM requests (GLINK over RPM MSG RAM) of Redmi Pad SE (xun, SM6225)
; Root-enumerated KMDF driver: talks to the RPM (clock and regulator votes).
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = XunRpm.cat
DriverVer   = ; set by stampinf
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
XunRpm.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceDesc% = XunRpm_Device, Root\XunRpm

[XunRpm_Device.NT]
CopyFiles = XunRpm_CopyFiles

[XunRpm_CopyFiles]
XunRpm.sys

[XunRpm_Device.NT.Services]
AddService = XunRpm, 0x00000002, XunRpm_Service

[XunRpm_Service]
DisplayName   = %ServiceName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\XunRpm.sys

[XunRpm_Device.NT.Wdf]
KmdfService = XunRpm, XunRpm_WdfSection

[XunRpm_WdfSection]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName     = "xun-woa"
ManufacturerName = "xun-woa"
DiskName         = "XunRpm Installation Disk"
DeviceDesc       = "RPM Requests (Redmi Pad SE)"
ServiceName      = "XunRpm"
